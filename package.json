{
  "name": "slidev-theme-excalidraw",
  "version": "0.1.0",
  "description": "A Slidev theme that looks like the deck was drawn in Excalidraw",
  "author": "Nuruzzaman Milon",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev",
    "excalidraw"
  ],
  "engines": {
    "node": ">=18.0.0",
    "slidev": ">=0.49.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "colorSchema": "light",
      "highlighter": "shiki",
      "fonts": {
        "provider": "none"
      }
    }
  },
  "files": [
    "components",
    "layouts",
    "styles",
    "setup",
    "global-bottom.vue"
  ],
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md",
    "screenshot": "slidev export slides.md --format png --output screenshots --scale 1.5 --wait 800"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@slidev/cli": "^52.1.0",
    "@slidev/types": "^52.1.0",
    "playwright-chromium": "^1.62.1"
  }
}
